.env
# output：只提交最终 Excel 报告，忽略中间过程文件
output/**/*
!output/**/
!output/**/基础教育学校信息_*.xlsx
!output/**/基础教育学校查询_*.xlsx
!output/**/医疗机构信息_*.xlsx
!output/**/高校建筑查询_*.xlsx

# Python 缓存与构建产物
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/
*.whl

# IDE 与编辑器
.idea/
*.iml
.vscode/
*.swp

# Agent 工作目录：本地记忆与临时产物，不随仓库分发
.workbuddy-ai/

# 日志与临时文件
*.log
debug.log
tmp/
*.tmp
